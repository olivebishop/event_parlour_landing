---
import BaseLayout from "@/src/layouts/BaseLayout.astro"
import { buttonVariants } from "@/components/ui/button"
import { cn } from "@/lib/utils"
---

<BaseLayout
  title="Page not found | Event Parlour"
  description="This page doesn't exist. Head back to Event Parlour to find events and sell tickets."
  path="/404"
  ogImagePath="/"
  noindex
>
  <main
    class="relative flex min-h-[100svh] w-full flex-col items-center justify-center overflow-x-clip bg-background px-4 py-10 sm:px-6 sm:py-14 md:px-8 md:py-16"
  >
    <div aria-hidden="true" class="hero-grid pointer-events-none absolute inset-0 opacity-60"></div>
    <div class="relative mx-auto flex w-full max-w-[min(100%,72rem)] flex-col items-start gap-6 sm:gap-8 md:gap-10">
      <div aria-hidden="true" class="relative isolate w-full max-w-full overflow-hidden">
        <video
          id="four-oh-four-video"
          autoplay
          loop
          muted
          playsinline
          preload="auto"
          tabindex="-1"
          class="absolute inset-0 h-full w-full object-cover motion-reduce:hidden"
        >
          <source src="/404.webm" type="video/webm" />
        </video>
        <div
          class="relative z-10 flex w-full select-none items-center justify-start overflow-hidden bg-white px-0.5 py-0.5 text-black mix-blend-screen dark:bg-black dark:text-white dark:mix-blend-multiply xs:px-1 sm:px-2"
        >
          <span
            class="block max-w-full whitespace-nowrap font-numbers text-[clamp(4.5rem,42vw,22rem)] font-medium leading-[0.85] tracking-[-0.05em]"
            style="-webkit-text-stroke: clamp(2px, 0.4vw, 6px) currentColor"
          >
            404
          </span>
        </div>
        <div class="pointer-events-none absolute inset-0 z-20 bg-background mix-blend-darken dark:mix-blend-lighten"></div>
      </div>
      <h1 class="max-w-md font-body text-pretty text-base leading-relaxed text-foreground/70 sm:text-lg md:text-xl">
        Not every event is worth attending. This page is one of them.
      </h1>
      <a href="/" class={cn(buttonVariants({ size: "cta" }), "w-full max-w-[14.5rem] sm:w-auto")}>
        Back to main page
      </a>
    </div>
  </main>
</BaseLayout>

<script>
  // Some browsers drop the `loop` attribute on webm — force infinite playback.
  const video = document.getElementById("four-oh-four-video") as HTMLVideoElement | null
  if (video) {
    video.addEventListener("ended", () => {
      video.currentTime = 0
      void video.play().catch(() => {})
    })
    void video.play().catch(() => {})
  }
</script>
